<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>TransitionCommand — Military Transition Command Center | KIBU Global Ventures</title>
<meta name="description" content="The complete military-to-civilian transition planning app. All branches, all separation types. One-time purchase, lifetime access. Built by veterans, for veterans.">
<meta name="author" content="KIBU Global Ventures LLC">
<meta property="og:title" content="TransitionCommand — Don't Leave Anything Behind">
<meta property="og:description" content="The complete military transition command center. VA claims, resume builder, timeline, finance calculator and more. $39 one-time.">
<meta property="og:type" content="website">
