<script>
// Tab preview data
const TABS=[
  {n:'Overview',ic:'📊',t:'Personalized Dashboard',s:'Built from your onboarding answers — your name, branch, days to separation, and top priority actions.',items:['Countdown to separation day','Task completion percentage','Priority action list','Mission snapshot summary','Quick-edit profile access']},
  {n:'Tasks',ic:'✅',t:'44-Task Checklist',s:'Every task organized by category with urgency ratings. Tap to mark complete — progress saves automatically.',items:['Administrative & Legal (8 tasks)','VA & Healthcare (9 tasks)','Finance & TSP (8 tasks)','Housing & Relocation (6 tasks)','Career & Education (7 tasks)','Family & Support (5 tasks)']},
  {n:'VA & Medical',ic:'🏥',t:'VA Claim Strategy',s:'The most financially impactful tab in the app. VA claims done wrong cost veterans tens of thousands in lifetime benefits.',items:['BDD filing timeline and guidance','Service-connected conditions tracker','C&P exam preparation checklist','TRICARE transition comparison','VSO referral and guidance','VA healthcare enrollment steps']},
  {n:'Resume',ic:'📄',t:'Live Resume Builder',s:'Type on the left, see your professional resume update on the right in real time.',items:['40+ MOS/Rate/AFSC civilian translations','Split-pane live preview','Military jargon → civilian language','Print to PDF in one click','Copy as plain text for job boards','Accomplishment bullet builder']},
  {n:'Finance',ic:'💰',t:'Financial Command Center',s:'The financial decisions made during transition can affect your family for decades. Get them right.',items:['Retirement pay calculator (High-3)','SBP election guide and warnings','TSP rollover strategy comparison','Transition budget planner','State tax on retirement pay research','Emergency fund target calculator']},
  {n:'Timeline',ic:'📅',t:'Auto-Generated Milestones',s:'Enter your separation date once. Get 23 personalized milestones automatically placed on your timeline.',items:['365 days out: TAP/ACAP registration','180 days out: VA BDD claim window','120 days out: job applications begin','90 days out: TRICARE decision deadline','0 days: Separation day milestone','Post-sep: VA rating decision tracking']},
  {n:'Certifications',ic:'🎓',t:'18-Month Certification Roadmap',s:'The only app that tells you exactly which certification to earn, how long it takes, what it costs, and how to get your branch to pay for it before you separate.',items:['60+ MOS/Rate/AFSC cert roadmaps','All 6 branches — enlisted & officer','Primary + secondary cert per specialty','COOL funding guide for every branch','18-month month-by-month study plan','Salary impact data for each credential']},
];

const tl=document.getElementById('tab-list');
const tc=document.getElementById('tab-content');
let ct=0;

function renderTabs(){
  tl.innerHTML=TABS.map((t,i)=>`<div class="tab-pill${i===ct?' a':''}" onclick="selTab(${i})">${t.ic} ${t.n}</div>`).join('');
  const t=TABS[ct];
  tc.innerHTML=`<div class="tc-title">${t.ic} ${t.t}</div><div class="tc-sub">${t.s}</div><div class="tc-items">${t.items.map(i=>`<div class="tc-item">${i}</div>`).join('')}</div>`;
}
function selTab(i){ct=i;renderTabs();}
renderTabs();

// FAQ toggle
function toggleFaq(el){
  const item=el.closest('.faq-item');
  document.querySelectorAll('.faq-item.open').forEach(o=>{if(o!==item)o.classList.remove('open');});
  item.classList.toggle('open');
}
</script>
