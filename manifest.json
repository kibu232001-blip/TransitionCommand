<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --nav:#1B2B4B;--nav2:#142040;--navt:#F5EFE0;
  --bg:#F7F3EE;--bg2:#EDE8E0;--surf:#FFFFFF;
  --ac:#C8881A;--ac2:#D9960F;--acl:#FEF3E0;
  --gr:#4A7C59;--grl:#EBF4EF;
  --tx:#1B2B4B;--tx2:#5A6A7A;--tx3:#94A3B8;
  --b1:rgba(27,43,75,.09);--b2:rgba(27,43,75,.16);
  --fd:'Barlow Condensed',system-ui,sans-serif;
  --fb:'Plus Jakarta Sans',system-ui,sans-serif;
}
html{scroll-behavior:smooth}
body{font-family:var(--fb);color:var(--tx);background:var(--surf);-webkit-font-smoothing:antialiased}

/* NAV */
nav{background:var(--nav);padding:0 24px;height:56px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;box-shadow:0 1px 0 rgba(255,255,255,.06)}
.nav-logo{font-family:var(--fd);font-size:20px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--navt);text-decoration:none}
.nav-logo em{color:var(--ac);font-style:normal}
.nav-cta{background:var(--ac);color:#fff;font-family:var(--fd);font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:8px 18px;border-radius:6px;text-decoration:none;transition:background .15s}
.nav-cta:hover{background:var(--ac2)}

/* HERO */
.hero{background:var(--nav);padding:80px 24px 90px;text-align:center;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 60% 0%,rgba(200,136,26,.1) 0%,transparent 65%);pointer-events:none}
.hero-badge{display:inline-block;background:rgba(200,136,26,.15);border:1px solid rgba(200,136,26,.3);border-radius:20px;padding:5px 14px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ac);margin-bottom:20px}
.hero-star{font-size:52px;margin-bottom:16px;display:block;animation:pulse 3s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.7}}
h1{font-family:var(--fd);font-size:clamp(42px,9vw,80px);font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:var(--navt);line-height:1;margin-bottom:12px}
h1 em{color:var(--ac);font-style:normal;display:block}
.hero-sub{font-size:clamp(15px,2.5vw,18px);color:rgba(245,239,224,.65);max-width:560px;margin:0 auto 32px;line-height:1.7}
.hero-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.btn-hero{display:inline-flex;align-items:center;gap:8px;padding:15px 28px;border-radius:8px;font-family:var(--fd);font-size:15px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;transition:all .15s;cursor:pointer;border:none}
.btn-primary{background:var(--ac);color:#fff}.btn-primary:hover{background:var(--ac2);transform:translateY(-1px)}
.btn-secondary{background:transparent;color:var(--navt);border:1.5px solid rgba(245,239,224,.25)}.btn-secondary:hover{border-color:rgba(245,239,224,.6)}
.hero-trust{display:flex;align-items:center;justify-content:center;gap:24px;margin-top:36px;flex-wrap:wrap}
.ht{font-size:12px;color:rgba(245,239,224,.45);display:flex;align-items:center;gap:6px}

/* STATS STRIP */
.stats{background:var(--ac);padding:28px 24px;display:grid;grid-template-columns:repeat(4,1fr);gap:1px}
.stat{text-align:center;padding:8px}
.stat-v{font-family:var(--fd);font-size:36px;font-weight:700;color:#fff}
.stat-l{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.7);margin-top:3px}
@media(max-width:600px){.stats{grid-template-columns:repeat(2,1fr)}}

/* SECTIONS */
section{padding:72px 24px;max-width:1000px;margin:0 auto}
.section-tag{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--ac);font-weight:600;margin-bottom:10px}
h2{font-family:var(--fd);font-size:clamp(32px,6vw,52px);font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:var(--nav);margin-bottom:14px;line-height:1.1}
.sec-sub{font-size:16px;color:var(--tx2);max-width:580px;line-height:1.7;margin-bottom:40px}

/* FEATURES GRID */
.feat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}
.feat-card{background:var(--bg);border:1px solid var(--b1);border-radius:14px;padding:24px;transition:all .2s}
.feat-card:hover{background:var(--surf);box-shadow:0 4px 24px rgba(27,43,75,.08);transform:translateY(-2px)}
.feat-ic{font-size:28px;margin-bottom:12px;display:block}
.feat-title{font-family:var(--fd);font-size:18px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--nav);margin-bottom:6px}
.feat-desc{font-size:13px;color:var(--tx2);line-height:1.6}

/* TAB PREVIEW */
.tabs-preview{background:var(--bg2);padding:48px 24px;border-top:1px solid var(--b1);border-bottom:1px solid var(--b1)}
.tabs-inner{max-width:1000px;margin:0 auto}
.tab-list{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:32px}
.tab-pill{background:var(--surf);border:1px solid var(--b2);border-radius:20px;padding:6px 16px;font-size:13px;font-weight:600;color:var(--tx2);cursor:pointer;transition:all .15s}
.tab-pill:hover,.tab-pill.a{background:var(--nav);color:var(--navt);border-color:var(--nav)}
.tab-content{background:var(--surf);border:1px solid var(--b1);border-radius:16px;padding:28px;min-height:200px}
.tc-title{font-family:var(--fd);font-size:24px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--nav);margin-bottom:6px}
.tc-sub{font-size:13px;color:var(--tx2);margin-bottom:20px}
.tc-items{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}
.tc-item{display:flex;align-items:flex-start;gap:8px;font-size:13px;color:var(--tx)}
.tc-item::before{content:'→';color:var(--ac);font-weight:700;flex-shrink:0}

/* TESTIMONIALS */
.testi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}
.tcard{background:var(--bg);border:1px solid var(--b1);border-radius:14px;padding:24px}
.tcard-q{font-size:14px;color:var(--tx);line-height:1.7;margin-bottom:16px;font-style:italic}
.tcard-by{display:flex;align-items:center;gap:10px}
.tcard-av{width:36px;height:36px;border-radius:50%;background:var(--nav);color:var(--navt);display:flex;align-items:center;justify-content:center;font-family:var(--fd);font-size:14px;font-weight:700;flex-shrink:0}
.tcard-name{font-size:13px;font-weight:600;color:var(--nav)}
.tcard-rank{font-size:11px;color:var(--tx3)}
.stars{color:var(--ac);font-size:14px;margin-bottom:10px}

/* PRICING */
.pricing-wrap{background:var(--bg2);padding:72px 24px;border-top:1px solid var(--b1)}
.pricing-inner{max-width:520px;margin:0 auto;text-align:center}
.price-card{background:var(--surf);border:2px solid var(--ac);border-radius:20px;padding:40px 32px;box-shadow:0 8px 40px rgba(200,136,26,.12)}
.price-tag{background:var(--ac);color:#fff;font-family:var(--fd);font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:5px 14px;border-radius:12px;display:inline-block;margin-bottom:20px}
.price-amt{font-family:var(--fd);font-size:72px;font-weight:800;color:var(--ac);line-height:1}
.price-once{font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--tx3);margin-bottom:28px}
.price-items{text-align:left;margin-bottom:32px}
.pi{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--b1);font-size:14px;color:var(--tx)}
.pi-ic{width:20px;height:20px;border-radius:50%;background:var(--grl);color:var(--gr);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0}
.btn-buy{display:block;width:100%;padding:16px;background:var(--nav);color:var(--navt);font-family:var(--fd);font-size:18px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;border:none;border-radius:10px;cursor:pointer;text-decoration:none;text-align:center;transition:all .15s;margin-bottom:12px}
.btn-buy:hover{background:var(--ac);transform:translateY(-1px)}
.price-guarantee{font-size:12px;color:var(--tx3);margin-top:16px}

/* BRANCHES */
.branches{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-bottom:40px}
.branch{background:var(--bg);border:1px solid var(--b1);border-radius:10px;padding:12px 20px;font-size:13px;font-weight:600;color:var(--tx2);display:flex;align-items:center;gap:8px}

/* FAQ */
.faq-list{max-width:680px}
.faq-item{border-bottom:1px solid var(--b1);padding:20px 0}
.faq-q{font-size:15px;font-weight:600;color:var(--nav);cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px}
.faq-a{font-size:14px;color:var(--tx2);line-height:1.7;margin-top:12px;display:none}
.faq-item.open .faq-a{display:block}
.faq-arr{color:var(--ac);font-size:18px;transition:transform .2s;flex-shrink:0}
.faq-item.open .faq-arr{transform:rotate(45deg)}

/* CTA BANNER */
.cta-banner{background:var(--nav);padding:72px 24px;text-align:center}
.cta-banner h2{color:var(--navt)}
.cta-banner .sec-sub{color:rgba(245,239,224,.6);margin-left:auto;margin-right:auto}

/* FOOTER */
footer{background:var(--nav2);padding:32px 24px;text-align:center}
.footer-logo{font-family:var(--fd);font-size:18px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:rgba(245,239,224,.5);margin-bottom:8px}
.footer-logo em{color:rgba(200,136,26,.6);font-style:normal}
.footer-copy{font-size:11px;color:rgba(245,239,224,.3);margin-top:6px}
.footer-links{display:flex;gap:20px;justify-content:center;margin-top:14px;flex-wrap:wrap}
.footer-links a{font-size:12px;color:rgba(245,239,224,.4);text-decoration:none}
.footer-links a:hover{color:rgba(245,239,224,.7)}

/* UTILS */
.center{text-align:center}
.maxw{max-width:1000px;margin:0 auto}
</style>
</head>
